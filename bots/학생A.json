{
  "name": "학생A",
  "build": "cpu",
  "rules": [
    {"when": "탄약 < 4",       "do": "탄약수집"},
    {"when": "체력 <= 1",      "do": "후퇴"},
    {"when": "보이는적 >= 1",  "do": "던지기"},
    {"when": "보이는적 == 0",  "do": "중앙이동"},
    {"when": "always",        "do": "접근"}
  ],
  "note": "'계속 던지고'는 적이 보이면 늘 던지는 것으로, '회복되면 다시 붙을래'는 체력이 2 이상이 되면 다시 접근하는 것으로 해석했습니다."
}
